{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/special-offer-activated.schema.json",
  "title": "Salla Special Offer Activated Webhook",
  "description": "Payload schema for special_offer.activated webhook event - triggered when special offer becomes active",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "special_offer.activated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "status", "activated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Special offer ID"
        },
        "name": {
          "type": "string",
          "description": "Special offer name"
        },
        "status": {
          "type": "string",
          "enum": ["active"],
          "description": "Offer status (active)"
        },
        "activated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Activation timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
