                      },
                      "amount": {
                        "type": "object",
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "description": "Order item amounts tax amount"
                          },
                          "currency": {
                            "type": "string",
                            "description": "Order item amounts tax caurrency"
                          }
                        }
                      }
                    }
                  },
                  "total": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "integer",
                        "description": "Order item amounts total amount"
                      },
                      "currency": {
                        "type": "string",
                        "description": "Order item amounts total currency"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "shipments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/1389473"
          }
        },
        "payment_methods": {
          "type": "array",
          "items": {
            "type": "object",
