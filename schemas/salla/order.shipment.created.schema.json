                  "properties": {
                    "amount": {
                      "type": "integer",
                      "description": "Order tax amount"
                    },
                    "currency": {
                      "type": "string",
                      "description": "Order tax amount currency"
                    }
                  }
                }
              }
            },
            "discounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Order discounts title"
                  },
                  "type": {
                    "type": "string",
                    "description": "Order discounts type"
                  },
                  "code": {
                    "type": "string",
                    "description": "Order discounts code"
                  },
                  "discount": {
                    "type": "string",
                    "description": "Order discount  value"
                  },
