{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/special-offer-created.schema.json",
  "title": "Salla Special Offer Created Webhook",
  "description": "Payload schema for special_offer.created webhook event - triggered when special offer is created",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "special_offer.created"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "created_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Special offer ID"
        },
        "name": {
          "type": "string",
          "description": "Special offer name"
        },
        "description": {
          "type": "string",
          "description": "Special offer description"
        },
        "type": {
          "type": "string",
          "description": "Offer type (e.g., flash_sale, bundle)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "scheduled"],
          "description": "Offer status"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time",
          "description": "Offer start date"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time",
          "description": "Offer end date"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Special offer creation timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
