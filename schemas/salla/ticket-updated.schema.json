{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/ticket-updated.schema.json",
  "title": "Salla Ticket Updated Webhook",
  "description": "Payload schema for ticket.updated webhook event - triggered when ticket status changes",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "ticket.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "status", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Ticket ID"
        },
        "customer_id": {
          "type": "integer",
          "description": "Customer ID who created the ticket"
        },
        "subject": {
          "type": "string",
          "description": "Ticket subject"
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "waiting", "closed"],
          "description": "Updated ticket status"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"],
          "description": "Ticket priority"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Ticket update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
