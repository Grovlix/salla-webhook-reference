{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/invoice-updated.schema.json",
  "title": "Salla Invoice Updated Webhook",
  "description": "Payload schema for invoice.updated webhook event - triggered when invoice details are modified",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "invoice.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "order_id", "amount", "currency", "status", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Invoice ID"
        },
        "order_id": {
          "type": "integer",
          "description": "Associated order ID"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Invoice amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., SAR)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "paid", "cancelled"],
          "description": "Invoice status"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Invoice update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
