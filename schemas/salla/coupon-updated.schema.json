{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/coupon-updated.schema.json",
  "title": "Salla Coupon Updated Webhook",
  "description": "Payload schema for coupon.updated webhook event - triggered when coupon is modified",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "coupon.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "code", "discount", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Coupon ID"
        },
        "code": {
          "type": "string",
          "description": "Coupon code"
        },
        "description": {
          "type": "string",
          "description": "Coupon description"
        },
        "discount": {
          "type": "number",
          "minimum": 0,
          "description": "Discount amount or percentage"
        },
        "discount_type": {
          "type": "string",
          "enum": ["fixed", "percentage"],
          "description": "Discount type"
        },
        "max_uses": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of uses"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Coupon update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
