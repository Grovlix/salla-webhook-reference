{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/payment-paid.schema.json",
  "title": "Salla Payment Paid Webhook",
  "description": "Payload schema for payment.paid webhook event - triggered when payment is successful",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "payment.paid"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "order_id", "amount", "currency", "payment_method", "status", "paid_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Payment ID"
        },
        "order_id": {
          "type": "integer",
          "description": "Associated order ID"
        },
        "order_reference": {
          "type": "string",
          "description": "Order reference number"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Payment amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., SAR)"
        },
        "payment_method": {
          "type": "string",
          "enum": ["cod", "visa", "mada", "applepay", "stc_pay", "tabby", "tamara", "checkout"],
          "description": "Payment method used"
        },
        "gateway": {
          "type": "string",
          "description": "Payment gateway used"
        },
        "status": {
          "type": "string",
          "enum": ["paid"],
          "description": "Payment status (paid)"
        },
        "transaction_id": {
          "type": "string",
          "description": "Transaction ID from payment gateway"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time",
          "description": "Payment timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
