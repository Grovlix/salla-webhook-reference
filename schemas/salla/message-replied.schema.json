{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/message-replied.schema.json",
  "title": "Salla Message Replied Webhook",
  "description": "Payload schema for message.replied webhook event - triggered when message is replied",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "message.replied"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "customer_id", "message", "replied_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Message ID"
        },
        "customer_id": {
          "type": "integer",
          "description": "Customer ID who the reply was sent to"
        },
        "message": {
          "type": "string",
          "description": "Reply message content"
        },
        "conversation_id": {
          "type": "integer",
          "description": "Conversation ID"
        },
        "replied_at": {
          "type": "string",
          "format": "date-time",
          "description": "Reply timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
