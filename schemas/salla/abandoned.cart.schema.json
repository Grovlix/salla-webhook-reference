              "examples": [
                "SAR"
              ]
            }
          },
          "description": "The sum of the prices of all the items in a cart."
        },
        "subtotal": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "description": "Subtotal amount"
            },
            "currency": {
              "type": "string",
              "examples": [
                "SAR"
              ],
              "description": "Subtotal currency"
            }
          },
          "description": "The sub-total cost of items in a shopping cart."
        },
        "total_discount": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "description": "Discount amount"
            },
            "currency": {
              "type": "string",
              "examples": [
                "SAR"
              ],
              "description": "Discount currency"
            }
          },
          "description": "Cumulative reduction in price applied to the items in a cart."
        },
        "checkout_url": {
          "type": "string",
