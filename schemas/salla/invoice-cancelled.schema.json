{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/invoice-cancelled.schema.json",
  "title": "Salla Invoice Cancelled Webhook",
  "description": "Payload schema for invoice.cancelled webhook event - triggered when invoice is cancelled",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "invoice.cancelled"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "order_id", "status", "cancelled_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Invoice ID"
        },
        "order_id": {
          "type": "integer",
          "description": "Associated order ID"
        },
        "status": {
          "type": "string",
          "enum": ["cancelled"],
          "description": "Invoice status (cancelled)"
        },
        "cancelled_at": {
          "type": "string",
          "format": "date-time",
          "description": "Cancellation timestamp"
        },
        "reason": {
          "type": "string",
          "description": "Cancellation reason"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
