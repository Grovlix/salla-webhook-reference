{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/store-updated.schema.json",
  "title": "Salla Store Updated Webhook",
  "description": "Payload schema for store.updated webhook event - triggered when store settings change",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "store.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "updated_at"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Store ID"
        },
        "name": {
          "type": "string",
          "description": "Store name"
        },
        "description": {
          "type": "string",
          "description": "Store description"
        },
        "domain": {
          "type": "string",
          "description": "Store domain"
        },
        "logo": {
          "type": "string",
          "format": "uri",
          "description": "Store logo URL"
        },
        "currency": {
          "type": "string",
          "description": "Store currency code"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Store update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
