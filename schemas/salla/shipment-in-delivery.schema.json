{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/shipment-in-delivery.schema.json",
  "title": "Salla Shipment In Delivery Webhook",
  "description": "Payload schema for shipment.in_delivery webhook event - triggered when shipment is out for delivery",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "shipment.in_delivery"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "order_id", "status", "in_delivery_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Shipment ID"
        },
        "order_id": {
          "type": "integer",
          "description": "Associated order ID"
        },
        "tracking_number": {
          "type": "string",
          "description": "Shipment tracking number"
        },
        "status": {
          "type": "string",
          "enum": ["in_delivery"],
          "description": "Shipment status (in_delivery)"
        },
        "in_delivery_at": {
          "type": "string",
          "format": "date-time",
          "description": "In delivery timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
