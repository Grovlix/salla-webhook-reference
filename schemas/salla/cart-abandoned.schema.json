{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/cart-abandoned.schema.json",
  "title": "Salla Cart Abandoned Webhook",
  "description": "Payload schema for cart.abandoned webhook event - triggered when customer leaves items in cart without purchase",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "cart.abandoned"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "customer", "items", "total", "currency", "abandoned_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Cart ID"
        },
        "customer": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "type": "integer",
              "description": "Customer ID"
            },
            "name": {
              "type": "string",
              "description": "Customer name"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Customer email address"
            },
            "phone": {
              "type": "string",
              "description": "Customer phone number"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product_id", "name", "quantity", "price"],
            "properties": {
              "product_id": {
                "type": "integer",
                "description": "Product ID"
              },
              "name": {
                "type": "string",
                "description": "Product name"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "Item quantity"
              },
              "price": {
                "type": "number",
                "minimum": 0,
                "description": "Price per unit"
              }
            }
          }
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Cart total amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., SAR)"
        },
        "abandoned_at": {
          "type": "string",
          "format": "date-time",
          "description": "Cart abandonment timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
