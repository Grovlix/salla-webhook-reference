{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/category-deleted.schema.json",
  "title": "Salla Category Deleted Webhook",
  "description": "Payload schema for category.deleted webhook event - triggered when a category is deleted",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "category.deleted"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "deleted_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique category identifier that was deleted"
        },
        "name": {
          "type": "string",
          "description": "Category name (for reference)"
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time",
          "description": "Deletion timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
