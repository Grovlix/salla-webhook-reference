{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/store-settings-updated.schema.json",
  "title": "Salla Store Settings Updated Webhook",
  "description": "Payload schema for store.settings.updated webhook event - triggered when store settings are modified",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "store.settings.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["updated_at"],
      "properties": {
        "updated_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of setting fields that were updated"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Settings update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
