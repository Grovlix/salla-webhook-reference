{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/order-created.schema.json",
  "title": "Salla Order Created Webhook",
  "description": "Payload schema for order.created webhook event - triggered when a new order is created",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "order.created"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "reference", "status", "payment_status", "customer", "items", "total", "currency", "created_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique order identifier"
        },
        "reference": {
          "type": "string",
          "description": "Order reference number"
        },
        "status": {
          "type": "string",
          "enum": ["new", "preparing", "ready", "in_delivery", "delivered", "cancelled", "returned", "failed"],
          "description": "Current order status"
        },
        "payment_status": {
          "type": "string",
          "description": "Payment status of the order"
        },
        "customer": {
          "type": "object",
          "required": ["id", "name", "phone"],
          "properties": {
            "id": {
              "type": "integer",
              "description": "Customer ID"
            },
            "name": {
              "type": "string",
              "description": "Customer name"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Customer email address"
            },
            "phone": {
              "type": "string",
              "description": "Customer phone number"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "product_id", "name", "quantity", "price", "total"],
            "properties": {
              "id": {
                "type": "integer",
                "description": "Order item ID"
              },
              "product_id": {
                "type": "integer",
                "description": "Product ID"
              },
              "name": {
                "type": "string",
                "description": "Product name"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "Item quantity"
              },
              "price": {
                "type": "number",
                "minimum": 0,
                "description": "Price per unit"
              },
              "total": {
                "type": "number",
                "minimum": 0,
                "description": "Total price for this item"
              }
            }
          }
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Order total amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., SAR)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Order creation timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
