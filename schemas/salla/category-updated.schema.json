{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/category-updated.schema.json",
  "title": "Salla Category Updated Webhook",
  "description": "Payload schema for category.updated webhook event - triggered when category details are updated",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "category.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique category identifier"
        },
        "name": {
          "type": "string",
          "description": "Category name"
        },
        "description": {
          "type": "string",
          "description": "Category description"
        },
        "parent_id": {
          "type": "integer",
          "description": "Parent category ID (if nested)"
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly category identifier"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Category update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
