{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/branch-updated.schema.json",
  "title": "Salla Branch Updated Webhook",
  "description": "Payload schema for branch.updated webhook event - triggered when branch details are modified",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "branch.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Branch ID"
        },
        "name": {
          "type": "string",
          "description": "Branch name"
        },
        "phone": {
          "type": "string",
          "description": "Branch phone number"
        },
        "city": {
          "type": "string",
          "description": "Branch city"
        },
        "address": {
          "type": "string",
          "description": "Branch address"
        },
        "latitude": {
          "type": "number",
          "description": "Branch latitude"
        },
        "longitude": {
          "type": "number",
          "description": "Branch longitude"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Branch update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
