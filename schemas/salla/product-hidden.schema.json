{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/product-hidden.schema.json",
  "title": "Salla Product Hidden Webhook",
  "description": "Payload schema for product.hidden webhook event - triggered when product is hidden",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "product.hidden"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "status", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "status": {
          "type": "string",
          "enum": ["hidden"],
          "description": "Product visibility status"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Status update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
