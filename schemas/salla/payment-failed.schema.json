{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/payment-failed.schema.json",
  "title": "Salla Payment Failed Webhook",
  "description": "Payload schema for payment.failed webhook event - triggered when payment fails",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "payment.failed"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "order_id", "amount", "currency", "status", "failed_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Payment ID"
        },
        "order_id": {
          "type": "integer",
          "description": "Associated order ID"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Attempted payment amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., SAR)"
        },
        "payment_method": {
          "type": "string",
          "description": "Payment method attempted"
        },
        "gateway": {
          "type": "string",
          "description": "Payment gateway used"
        },
        "status": {
          "type": "string",
          "enum": ["failed"],
          "description": "Payment status (failed)"
        },
        "error_code": {
          "type": "string",
          "description": "Error code from payment gateway"
        },
        "error_message": {
          "type": "string",
          "description": "Error message"
        },
        "failed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Payment failure timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
