{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/message-received.schema.json",
  "title": "Salla Message Received Webhook",
  "description": "Payload schema for message.received webhook event - triggered when new message is received",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "message.received"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "customer_id", "message", "received_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Message ID"
        },
        "customer_id": {
          "type": "integer",
          "description": "Customer ID who sent the message"
        },
        "customer_name": {
          "type": "string",
          "description": "Customer name"
        },
        "message": {
          "type": "string",
          "description": "Message content"
        },
        "conversation_id": {
          "type": "integer",
          "description": "Conversation ID"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "description": "Message attachments"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "Message receive timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
