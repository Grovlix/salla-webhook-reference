{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/product-created.schema.json",
  "title": "Salla Product Created Webhook",
  "description": "Payload schema for product.created webhook event - triggered when a new product is created",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "product.created"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "price", "quantity", "status", "created_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "description": {
          "type": "string",
          "description": "Product description"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "Product regular price"
        },
        "sale_price": {
          "type": "number",
          "minimum": 0,
          "description": "Product sale price (optional)"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0,
          "description": "Stock quantity"
        },
        "sku": {
          "type": "string",
          "description": "Product SKU"
        },
        "status": {
          "type": "string",
          "enum": ["active", "hidden", "out_of_stock"],
          "description": "Product status"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Product category IDs"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "description": "Product images"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Product creation timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
