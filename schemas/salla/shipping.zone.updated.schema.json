      },
      "cities_excluded": [
        {
          "id": 257742554,
          "name": "أبو حليفة",
          "name_en": "ABU HALIFA"
        },
        {
          "id": 81998629,
          "name": "الأحمدي",
          "name_en": "AHMADI"
        }
      ],
      "fees": {
        "amount": "30",
        "currency": "SAR",
        "type": "rate",
        "weight_unit": "kg",
        "up_to_weight": "15",
