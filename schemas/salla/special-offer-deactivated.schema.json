{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/special-offer-deactivated.schema.json",
  "title": "Salla Special Offer Deactivated Webhook",
  "description": "Payload schema for special_offer.deactivated webhook event - triggered when special offer becomes inactive",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "special_offer.deactivated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "status", "deactivated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Special offer ID"
        },
        "name": {
          "type": "string",
          "description": "Special offer name"
        },
        "status": {
          "type": "string",
          "enum": ["inactive"],
          "description": "Offer status (inactive)"
        },
        "deactivated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Deactivation timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
