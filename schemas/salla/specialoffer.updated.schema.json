{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specialoffer.updated",
  "description": "Triggered when a special offer is updated. Generated from https://docs.salla.dev/webhook-events/special-offers (fetched 2026-10-26).",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "description": "a label or title used to identify a specific event.",
      "enum": [
        "specialoffer.created",
        "specialoffer.updated"
      ]
    },
    "merchant": {
      "type": "number",
      "description": "Merchant ID who installed the application on their store. Get details on the Merchant via the ID  using the endpoint [here](https://docs.salla.dev/api-8330089)",
      "examples": [
        814202285
      ]
    },
    "created_at": {
      "type": "string",
      "description": "The date and time when a particular Webhook was created or initiated.",
      "examples": [
        "Tue Aug 03 2021 09:30:16 GMT+0300"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "A unique identifier assigned to the special offer id. ",
          "examples": [
            525144736
          ]
        },
        "message": {
          "type": "string",
          "description": "A promotional message or notification that communicates a specific deal, discount, promotion, or incentive to customers. ",
          "examples": [
            "اشتري قطعة واحصل على خصم 10 ر.س من المنتجات التالية"
          ]
        },
        "expiry_date": {
          "type": "string",
          "description": "The date on which a promotional or discount offer is set to expire or become no longer valid. ",
          "examples": [
            "2021-08-09"
          ]
        },
        "offer_type": {
          "type": "string",
          "description": "The category or classification of a specific promotion, discount, or incentive within a marketing or sales context.",
          "examples": [
            "fixed_amount"
          ],
          "enum": [
            "fixed_amount",
            "buy_x_get_y",
            "percentage"
          ]
        },
        "status": {
          "type": "string",
          "description": "The current condition or state of a promotional offer. ",
          "examples": [
            "active"
          ]
        },
        "applied_to": {
          "type": "string",
          "description": "The way a promotional or discount offer is implemented to or used.",
          "examples": [
            "order"
          ]
        },
        "buy": {
          "type": "object",
          "properties": {
            "min_amount": {
              "type": "string",
              "description": "Minimum amount of purchase to entitle for the special offer. \r\n",
              "examples": [
                "100"
              ]
            },
            "min_items": {
              "type": "number",
              "description": "Minimum items to be purchaseed to entitle for the special offer. \r\n",
              "examples": [
                0
              ]
            },
            "categories": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/1307295"
              },
              "description": "Contains all categories details that are included in the offer"
            },
            "products": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/1307389"
              },
              "description": "Contains all products details that are included in the offer"
            },
            "type": {
              "type": "string",
              "description": "The type of the offer in `buy` section in case of `buy_x_get_y`"
            }
          }
        },
        "get": {
          "type": "object",
          "properties": {
            "discount_amount": {
              "type": "string",
              "description": "Discount amount value.",
              "examples": [
                "10"
              ]
            },
            "type": {
              "type": "string",
              "examples": [
                "products",
                "category",
                "product"
              ],
              "description": "The type of the offer in `get` section in case of `buy_x_get_y`"
            },
            "categories": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/1307295"
              },
              "description": "Contains all categories details that are included in the offer"
            },
            "products": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/1307389"
              },
              "description": "Contains all products details that are included in the offer"
            },
            "discount_type": {
              "type": "string",
              "description": "Discount type of the `get` sectin",
              "enum": [
                "fixed",
                "percentage"
              ]
            }
          }
        }
      }
    }
  },
