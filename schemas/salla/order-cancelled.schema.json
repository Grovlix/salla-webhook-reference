{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/order-cancelled.schema.json",
  "title": "Salla Order Cancelled Webhook",
  "description": "Payload schema for order.cancelled webhook event - triggered when an order is cancelled",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "order.cancelled"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "reference", "status", "cancelled_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique order identifier"
        },
        "reference": {
          "type": "string",
          "description": "Order reference number"
        },
        "status": {
          "type": "string",
          "enum": ["cancelled"],
          "description": "Order status (cancelled)"
        },
        "cancelled_at": {
          "type": "string",
          "format": "date-time",
          "description": "Cancellation timestamp"
        },
        "reason": {
          "type": "string",
          "description": "Cancellation reason (optional)"
        },
        "cancelled_by": {
          "type": "string",
          "enum": ["merchant", "customer", "system"],
          "description": "Who cancelled the order"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
