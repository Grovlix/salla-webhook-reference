{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/product-quantity-updated.schema.json",
  "title": "Salla Product Quantity Updated Webhook",
  "description": "Payload schema for product.quantity.updated webhook event - triggered when product stock quantity changes",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "product.quantity.updated"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "name", "quantity", "updated_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique product identifier"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "old_quantity": {
          "type": "integer",
          "minimum": 0,
          "description": "Previous stock quantity"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0,
          "description": "New stock quantity"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Quantity update timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
