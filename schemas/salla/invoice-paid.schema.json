{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/invoice-paid.schema.json",
  "title": "Salla Invoice Paid Webhook",
  "description": "Payload schema for invoice.paid webhook event - triggered when invoice payment is completed",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "invoice.paid"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["id", "order_id", "amount", "currency", "status", "paid_at"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Invoice ID"
        },
        "order_id": {
          "type": "integer",
          "description": "Associated order ID"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Payment amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., SAR)"
        },
        "status": {
          "type": "string",
          "enum": ["paid"],
          "description": "Invoice status (paid)"
        },
        "payment_method": {
          "type": "string",
          "description": "Payment method used"
        },
        "transaction_id": {
          "type": "string",
          "description": "Transaction ID"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time",
          "description": "Payment timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
