{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/salla/store-app-installed.schema.json",
  "title": "Salla Store App Installed Webhook",
  "description": "Payload schema for store.app.installed webhook event - triggered when app is installed",
  "type": "object",
  "required": ["event", "store_id", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "store.app.installed"
    },
    "store_id": {
      "type": "string",
      "description": "The store ID that triggered the event"
    },
    "data": {
      "type": "object",
      "required": ["app_id", "app_name", "installed_at"],
      "properties": {
        "app_id": {
          "type": "string",
          "description": "App ID that was installed"
        },
        "app_name": {
          "type": "string",
          "description": "App name"
        },
        "store_id": {
          "type": "string",
          "description": "Store ID that installed the app"
        },
        "merchant_id": {
          "type": "string",
          "description": "Merchant ID"
        },
        "installed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Installation timestamp"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Webhook event creation timestamp"
    }
  }
}
