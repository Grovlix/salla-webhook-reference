{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/zid/order-create.schema.json",
  "title": "Zid Order Create Webhook",
  "description": "Payload schema for order.create webhook event - triggered when a new order is created",
  "type": "object",
  "required": ["event", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "order.create"
    },
    "data": {
      "type": "object",
      "required": ["id", "status", "payment_status", "items", "total", "currency"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique order identifier"
        },
        "reference": {
          "type": "string",
          "description": "Order reference number"
        },
        "status": {
          "type": "string",
          "enum": ["new", "preparing", "ready", "inDelivery", "delivered", "cancelled"],
          "description": "Current order status"
        },
        "payment_status": {
          "type": "string",
          "enum": ["paid", "unpaid", "pending", "refunded", "voided"],
          "description": "Payment status"
        },
        "customer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Customer ID"
            },
            "name": {
              "type": "string",
              "description": "Customer name"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              },
              "price": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          }
        },
        "total": {
          "type": "number",
          "description": "Order total"
        },
        "currency": {
          "type": "string",
          "description": "Currency code"
        },
        "payment_method": {
          "type": "string",
          "enum": ["Cash On Delivery", "Credit Card", "Bank Transfer"],
          "description": "Payment method"
        },
        "delivery_option_id": {
          "type": "integer",
          "description": "Delivery option ID"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
