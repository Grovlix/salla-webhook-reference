{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/zid/product-publish.schema.json",
  "title": "Zid Product Publish Webhook",
  "description": "Payload schema for product.publish webhook event - triggered when product is published",
  "type": "object",
  "required": ["event", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "product.publish"
    },
    "data": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Product ID"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "status": {
          "type": "string",
          "enum": ["published"],
          "description": "Product status"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
