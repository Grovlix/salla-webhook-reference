{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/zid/order-status-update.schema.json",
  "title": "Zid Order Status Update Webhook",
  "description": "Payload schema for order.status.update webhook event - triggered when order status changes",
  "type": "object",
  "required": ["event", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "order.status.update"
    },
    "data": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Order ID"
        },
        "reference": {
          "type": "string",
          "description": "Order reference number"
        },
        "status": {
          "type": "string",
          "enum": ["new", "preparing", "ready", "inDelivery", "delivered", "cancelled"],
          "description": "New order status"
        },
        "previous_status": {
          "type": "string",
          "enum": ["new", "preparing", "ready", "inDelivery", "delivered", "cancelled"],
          "description": "Previous order status"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
