{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Grovlix/salla-webhook-reference/schemas/zid/product-delete.schema.json",
  "title": "Zid Product Delete Webhook",
  "description": "Payload schema for product.delete webhook event - triggered when product is deleted",
  "type": "object",
  "required": ["event", "data"],
  "properties": {
    "event": {
      "type": "string",
      "const": "product.delete"
    },
    "data": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Product ID that was deleted"
        },
        "name": {
          "type": "string",
          "description": "Product name (for reference)"
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
