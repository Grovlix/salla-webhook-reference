  "properties": {
    "id": {
      "type": "null",
      "description": "Unique identifier for the product. (Set to null if is_external_product is true)"
    },
    "product_class": {
      "type": "string",
      "description": " Set to \"grouped_product\" to indicate it's a group of sub-products."
    },
    "sku": {
      "type": "string",
      "description": "Stock Keeping Unit - unique identifier that allows a product to be tracked for inventory purposes."
    },
    "barcode": {
      "type": "string",
      "description": "This field allows you to specify a barcode associated with the product, if applicable."
    },
    "parent_id": {
      "type": "null",
      "description": "Unique identifier for the parent product, if any. This product could be a variant of the parent product. (Set to null if is_external_product is true)"
    },
    "slug": {
      "type": "string",
      "description": "SEO friendly URL, usually derived from the product name."
    },
    "price": {
      "type": "integer",
      "description": "Base price of the grouped product (100.0)."
    },
    "short_description": {
      "type": "null",
      "description": "This field is optional and can be used to provide a brief description of the product."
    },
    "sale_price": {
      "type": "integer",
      "description": "If the product is on sale, this field specifies the discounted price in the smallest currency unit.",
      "examples": [
        50
      ]
    },
    "formatted_price": {
      "type": "string",
      "description": "This field contains the base price formatted according to the currency settings.",
      "examples": [
        "10$"
      ]
    },
    "formatted_sale_price": {
      "type": "string",
      "description": " If applicable, this field holds the formatted discounted price.",
      "examples": [
        "8$"
      ]
    },
    "currency": {
      "type": "string"
    },
    "currency_symbol": {
