# Salla/Zid Webhook Configuration
# إعدادات الويب هوك لـ Salla و Zid

# Server Configuration
# إعدادات الخادم
PORT=3000
NODE_ENV=development

# Salla Webhook Secret
# سر الويب هوك لـ Salla
# Get this from your Salla dashboard > Settings > Developers > Webhooks
# احصل على هذا من لوحة تحكم Salla > الإعدادات > المطورون > Webhooks
SALLA_WEBHOOK_SECRET=your_salla_webhook_secret_here

# Zid Webhook Secret
# سر الويب هوك لـ Zid
# Get this from your Zid dashboard > Settings > Developers > Webhooks
# احصل على هذا من لوحة تحكم Zid > الإعدادات > المطورون > Webhooks
ZID_WEBHOOK_SECRET=your_zid_webhook_secret_here

# Logging Configuration
# إعدادات التسجيل
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/webhooks.log

# Rate Limiting (requests per minute)
# الحد من المعدل (الطلبات في الدقيقة)
RATE_LIMIT_MAX=60

# Retry Configuration
# إعدادات إعادة المحاولة
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000

# Database Configuration (Optional)
# إعدادات قاعدة البيانات (اختياري)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=webhooks
# DB_USER=webhook_user
# DB_PASSWORD=webhook_password

# External Services (Optional)
# خدمات خارجية (اختياري)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL
