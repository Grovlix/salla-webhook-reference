# Python FastAPI Dockerfile for Salla/Zid Webhook Handler
# Dockerfile لمعالج الويب هوك بـ Python FastAPI

FROM python:3.11-slim

# Set working directory
# تعيين دليل العمل
WORKDIR /app

# Install system dependencies
# تثبيت التبعيات النظامية
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
# نسخ ملف المتطلبات
COPY requirements.txt .

# Install Python dependencies
# تثبيت تبعيات Python
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
# نسخ ملفات التطبيق
COPY . .

# Create non-root user
# إنشاء مستخدم غير جذري
RUN useradd -m -u 1001 appuser && \
    chown -R appuser:appuser /app

# Switch to non-root user
# التبديل إلى مستخدم غير جذري
USER appuser

# Expose port
# كشف المنفذ
EXPOSE 8000

# Start application
# بدء التطبيق
CMD ["uvicorn", "fastapi_webhook_handler:app", "--host", "0.0.0.0", "--port", "8000"]
