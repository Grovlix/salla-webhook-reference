            {
              "value": "store.branch.created",
              "name": "Store Branch Created",
              "description": "Triggered when a new store branch is created."
            },
            {
              "value": "store.branch.updated",
              "name": "Store Branch Updated",
              "description": "Triggered when an existing store branch is updated."
            },
            {
              "value": "store.branch.deleted",
              "name": "Store Branch Deleted",
              "description": "Triggered when a store branch is deleted or removed."
            },
            {
              "value": "store.branch.setDefault",
              "name": "Store Branch Set as Default",
              "description": "Triggered when a store branch is set as the default branch."
