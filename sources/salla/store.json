      "x-stoplight": {
        "id": "l0tv9zduxls64"
      },
      "type": "object",
      "x-tags": [
        "Store Events Webhook Model"
      ],
      "properties": {
        "event": {
          "type": "string",
          "description": "Event title or label to represent the event.",
